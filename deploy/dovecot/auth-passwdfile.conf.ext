passdb {
  driver = passwd-file
  # Copie publiée hors /var/lib/vzone (souvent 700) — lisible par auth-worker=vmail
  # Le préfixe {SHA512-CRYPT} dans le fichier prime ; pas de scheme= forcé
  args = username_format=%u /etc/dovecot/vzone-users
}
userdb {
  driver = passwd-file
  args = username_format=%u /etc/dovecot/vzone-users
}
