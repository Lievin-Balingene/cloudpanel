passdb {
  driver = passwd-file
  # scheme=SHA512-CRYPT + hash $6$… nu (pas de préfixe {…})
  # Fichier : /etc/dovecot/vzone-users en 0640 root:dovecot
  args = scheme=SHA512-CRYPT username_format=%u /etc/dovecot/vzone-users
}
userdb {
  driver = passwd-file
  args = username_format=%u /etc/dovecot/vzone-users
}
