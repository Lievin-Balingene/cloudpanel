[Unit]
Description=V-zone Panel API (Daphne ASGI)
After=network.target postgresql.service redis.service redis-server.service
Wants=postgresql.service

[Service]
Type=simple
User=vzone
Group=vzone
WorkingDirectory=/opt/vzone/backend
EnvironmentFile=/etc/vzone/vzone.env
Environment=DJANGO_SETTINGS_MODULE=vzone.settings.production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=/opt/vzone/backend/.venv/bin/daphne -b 127.0.0.1 -p 8000 vzone.asgi:application
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=10
KillMode=process
TasksMax=infinity
NoNewPrivileges=true
PrivateTmp=true
# Relancer les apps Python clientes après démarrage API (évite 502 nginx → ports morts)
ExecStartPost=/bin/bash -c 'sleep 2; cd /opt/vzone/backend && .venv/bin/python manage.py reconcile_python_apps || true'

[Install]
WantedBy=multi-user.target
