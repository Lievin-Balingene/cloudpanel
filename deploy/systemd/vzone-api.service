[Unit]
Description=V-zone Panel API (Daphne ASGI)
After=network.target postgresql.service redis.service redis-server.service
Wants=postgresql.service

[Service]
Type=simple
User=vzone
Group=vzone
WorkingDirectory=/opt/vzone/backend
EnvironmentFile=/etc/vzone/vzone.env
Environment=DJANGO_SETTINGS_MODULE=vzone.settings.production
ExecStart=/opt/vzone/backend/.venv/bin/daphne -b 127.0.0.1 -p 8000 vzone.asgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
