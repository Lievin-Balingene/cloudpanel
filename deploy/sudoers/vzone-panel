# Homes + terminal jailé : helpers root allowlistés pour le user panel « vzone ».
# Installé par scripts/ensure-mkhome-sudoers.sh
#
# Les clients N'ONT PAS sudo, PAS de bash libre via sudoers panel.
# Le terminal passe uniquement par vzone-jailterm (bubblewrap → UID client + home only).

Defaults:vzone !requiretty
Defaults:vzone !authenticate

# Création home + membership groupe
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-mkhome

# Terminal web jailé (argument = username client validé dans le helper)
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-jailterm, /usr/local/sbin/vzone-jailterm *
