# Homes + terminaux : helpers root allowlistés pour le user panel « vzone ».
# Installé par scripts/ensure-mkhome-sudoers.sh
#
# - Clients  : vzone-jailterm (bubblewrap, UID client, home only) — PAS de root
# - Admin WHM: vzone-rootterm (shell root) — comme cPanel WHM Terminal

Defaults:vzone !requiretty
Defaults:vzone !authenticate

# Création home + membership groupe
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-mkhome

# Terminal client jailé
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-jailterm, /usr/local/sbin/vzone-jailterm *

# Terminal admin WHM (root)
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-rootterm, /usr/local/sbin/vzone-rootterm --check
