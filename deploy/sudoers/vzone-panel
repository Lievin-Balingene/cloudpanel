# Homes + terminaux + runas : helpers root allowlistés pour « vzone ».
# Installé par scripts/ensure-mkhome-sudoers.sh
#
# - Clients  : vzone-jailterm / vzone-runas → UID client uniquement
# - Admin WHM: vzone-rootterm --ticket <path> (one-shot, pas d'appel libre)

Defaults:vzone !requiretty
Defaults:vzone !authenticate

# Création home + membership groupe
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-mkhome

# Terminal client jailé
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-jailterm, /usr/local/sbin/vzone-jailterm *

# Exécution apps / git deploy sous UID client
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-runas, /usr/local/sbin/vzone-runas *

# Propriétaire app (SQLite/media/logs) → UID client
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-fix-app-perms, /usr/local/sbin/vzone-fix-app-perms *

# Terminal admin WHM — UNIQUEMENT avec --ticket (pas d'appel nu → root)
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-rootterm --check
vzone ALL=(root) NOPASSWD: /usr/local/sbin/vzone-rootterm --ticket *
