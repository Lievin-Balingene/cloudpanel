# V-zone Panel — Variables d'environnement
# Copier vers .env et adapter.

VZONE_ENV=development
VZONE_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64
VZONE_DEBUG=true
VZONE_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
VZONE_DB_NAME=vzone
VZONE_DB_USER=vzone
VZONE_DB_PASSWORD=vzone_dev_password
VZONE_DB_HOST=127.0.0.1
VZONE_DB_PORT=5432

# Redis
VZONE_REDIS_URL=redis://127.0.0.1:6379/0
VZONE_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
VZONE_CHANNELS_REDIS_URL=redis://127.0.0.1:6379/2

# JWT
VZONE_JWT_ACCESS_MINUTES=30
VZONE_JWT_REFRESH_DAYS=7

# CORS / Frontend
VZONE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VZONE_FRONTEND_URL=http://localhost:5173

# Chemins système (production)
VZONE_DATA_ROOT=/var/lib/vzone
VZONE_LOG_ROOT=/var/log/vzone
VZONE_HOME_ROOT=/home
VZONE_NGINX_DOMAINS_DIR=/var/lib/vzone/nginx/domains
VZONE_WEB_STACK=auto
VZONE_OLS_ENABLED=auto
VZONE_OLS_LISTEN=127.0.0.1:8088
VZONE_OLS_ROOT=/usr/local/lsws
VZONE_OLS_DEFAULT_ENGINE=1

# Modules
VZONE_ENABLED_MODULES=core,accounts,packages,dns,dashboard,domains,files,ftp,email,databases,python_apps,node_apps,php,git_deploy,docker_mgmt,backups,monitoring,firewall,security
VZONE_SSL_BACKEND=auto
VZONE_FTP_AUTH_SECRET=
# Généré à l'install ; obligatoire en prod (endpoints FTP internes fail-closed si vide)
# VZONE_FTP_AUTH_SECRET=<openssl rand -hex 32>
VZONE_LINUX_USER_PROVISION=auto
VZONE_TERMINAL_FALLBACK_SAME_UID=false
# Terminal WHM admin = shell root (style cPanel). false pour le désactiver.
VZONE_TERMINAL_ALLOW_ADMIN=true
# VZONE_TRUST_X_FORWARDED_FOR=false
VZONE_WEBMAIL_URL=/webmail/
# Ports dédiés (style cPanel) — tout domaine:port ouvre le panneau concerné
#   domaine:9086 → Admin | domaine:9082 → Client | domaine:9095 → Webmail
VZONE_ADMIN_PORT=9086
VZONE_CLIENT_PORT=9082
VZONE_WEBMAIL_PORT=9095
# Hostnames panel sur :80/:443 (sans IP — IP nue = page SORRY! style cPanel)
# VZONE_PANEL_HOSTNAMES=panel.exemple.com
# E-mail affiché sur la page SORRY! (défaut: webmaster@<hostname panel>)
# VZONE_WEBMASTER_EMAIL=webmaster@server.vzonecloud.com
VZONE_ROUNDCUBE_SSO_DIR=/var/lib/vzone/roundcube/sso
VZONE_ROUNDCUBE_IMAP_HOST=127.0.0.1
VZONE_MAIL_MAPS_DIR=/var/lib/vzone/mail/maps
VZONE_MAIL_STACK=auto
VZONE_MAIL_PUBLIC_IP=
VZONE_DB_PROVISION_MODE=auto
VZONE_PHPMYADMIN_URL=/phpmyadmin/
VZONE_PHPMYADMIN_SSO_DIR=/var/lib/vzone/phpmyadmin/sso
VZONE_PGADMIN_URL=/pgadmin/
VZONE_MYSQL_HOST=
VZONE_MYSQL_ADMIN_USER=
VZONE_MYSQL_ADMIN_PASSWORD=
VZONE_PG_HOST=
VZONE_PG_ADMIN_USER=
VZONE_PG_ADMIN_PASSWORD=
VZONE_PYTHON_PROVISION_MODE=auto
VZONE_PYTHON_PORT_BASE=8100
VZONE_NODE_PROVISION_MODE=auto
VZONE_NODE_PORT_BASE=9100
VZONE_PHP_PROVISION_MODE=auto
VZONE_GIT_PROVISION_MODE=auto
VZONE_GIT_MAX_REPOS=20
VZONE_DOCKER_PROVISION_MODE=auto
VZONE_BACKUP_PROVISION_MODE=auto
VZONE_BACKUP_DIR=/var/lib/vzone/backups
VZONE_BACKUP_MAX=10
VZONE_RESTIC_BIN=restic
VZONE_RCLONE_BIN=rclone
VZONE_BACKUP_TIMEOUT=7200
VZONE_ALERT_COOLDOWN_MINUTES=30
VZONE_ALERT_DEFAULT_RECIPIENTS=
VZONE_FIREWALL_PROVISION_MODE=auto
VZONE_SECURITY_LOCKOUT_MAX_ATTEMPTS=5
VZONE_SECURITY_LOCKOUT_WINDOW_MINUTES=15
VZONE_SECURITY_LOCKOUT_DURATION_MINUTES=30

# AI Deployment Assistant (open source / auto-hébergeable)
# auto = Ollama local si dispo, sinon OpenAI-compat, sinon coach mock
VZONE_AI_PROVIDER=auto
VZONE_AI_OLLAMA_URL=http://127.0.0.1:11434
VZONE_AI_OLLAMA_MODEL=llama3.2
# VZONE_AI_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# VZONE_AI_OPENAI_API_KEY=
# VZONE_AI_OPENAI_MODEL=gpt-4o-mini
VZONE_AI_TIMEOUT_SEC=25
# VZONE_AI_OLLAMA_CIRCUIT_SEC=300
VZONE_AI_MAX_TOOL_ROUNDS=4
VZONE_AI_PENDING_TTL_SEC=600
VZONE_AI_RATE_LIMIT_PER_MIN=20

# Version
VZONE_VERSION=0.34.0
